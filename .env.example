# contentlist-mcp configuration — copy to .env (all optional; sane free defaults).

# --- Retrieval backends -----------------------------------------------------
# Self-hosted SearXNG (the "free like Google" web engine). See docker-compose.yml.
# Leave empty to run on RSS verticals only.
SEARXNG_URL=http://localhost:8080

# Tavily managed fallback — free tier is 1,000 credits/mo, no card. Empty = disabled.
TAVILY_API_KEY=

# --- Networking -------------------------------------------------------------
# CONTENTLIST_USER_AGENT=contentlist-mcp/0.1 (+https://github.com/tech-sumit/contentlist-mcp)
# HTTP_TIMEOUT=8
# FETCH_CONCURRENCY=8

# --- Cache TTLs (seconds) ---------------------------------------------------
# CACHE_TTL_DAY=300
# CACHE_TTL_WEEK=3600
# CACHE_TTL_DEFAULT=86400

# --- Behaviour --------------------------------------------------------------
# MAX_LIMIT=25
# BLOCKED_DOMAINS=example-spam.com,another.com

# --- MCP transport ----------------------------------------------------------
# streamable-http (hosted, default) or stdio (local client like Claude Desktop)
MCP_TRANSPORT=streamable-http
HOST=0.0.0.0
PORT=8000

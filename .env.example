# contentlist-mcp configuration — copy to .env (all optional; sane free defaults).

# --- Retrieval backends -----------------------------------------------------
# Self-hosted SearXNG (the "free like Google" web engine). See docker-compose.yml.
# Leave empty to run on RSS verticals only.
SEARXNG_URL=http://localhost:8080

# Tavily managed fallback — free tier is 1,000 credits/mo, no card. Empty = disabled.
TAVILY_API_KEY=

# Music vertical (iTunes RSS / ListenBrainz / MusicBrainz) — all keyless & free.
# Storefront/locale for iTunes charts and music lookups ("us", "gb", "de", …).
# MUSIC_STOREFRONT=us

# --- Summaries: optional Claude Haiku pass (stays free/extractive by default) -
# Install the extra first:  pip install -e ".[llm]"
# ENABLE_LLM_SUMMARIES=false
# ANTHROPIC_API_KEY=
# LLM_SUMMARY_MODEL=claude-haiku-4-5

# --- Enrichment: fetch_page when a feed/search summary is thin --------------
# ENABLE_ENRICHMENT=true
# ENRICHMENT_MIN_CHARS=140
# ENRICHMENT_MAX_ITEMS=5

# --- Per-client rate limiting + backend circuit breakers --------------------
# RATE_LIMIT_RPM=60
# RATE_LIMIT_BURST=20
# BREAKER_FAIL_THRESHOLD=3
# BREAKER_RESET_SECONDS=30

# --- Networking -------------------------------------------------------------
# CONTENTLIST_USER_AGENT=contentlist-mcp/0.1 (+https://github.com/tech-sumit/contentlist-mcp)
# HTTP_TIMEOUT=8
# FETCH_CONCURRENCY=8

# --- Cache TTLs (seconds) ---------------------------------------------------
# CACHE_TTL_DAY=300
# CACHE_TTL_WEEK=3600
# CACHE_TTL_DEFAULT=86400

# --- Behaviour --------------------------------------------------------------
# MAX_LIMIT=25
# BLOCKED_DOMAINS=example-spam.com,another.com

# --- MCP transport ----------------------------------------------------------
# streamable-http (hosted, default) or stdio (local client like Claude Desktop)
MCP_TRANSPORT=streamable-http
HOST=0.0.0.0
PORT=8000
